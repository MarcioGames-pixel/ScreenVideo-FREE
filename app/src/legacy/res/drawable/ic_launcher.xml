<?xml version="1.0" encoding="utf-8"?>
<!-- Android 2.0–4.4 era: forward-facing, top-lit, tactile/matte icon,
     with a compact palette and a subtle drop shadow rather than 3D perspective. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item android:left="4dp" android:top="5dp" android:right="3dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp"/>
            <solid android:color="#55000000"/>
        </shape>
    </item>
    <!-- Front-facing matte body -->
    <item android:left="3dp" android:top="3dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp"/>
            <gradient android:angle="270" android:startColor="#8197A0" android:centerColor="#627B86" android:endColor="#435B67"/>
            <stroke android:width="1dp" android:color="#344A55"/>
        </shape>
    </item>
    <!-- Camera/viewfinder symbol -->
    <item android:left="8dp" android:top="11dp" android:right="8dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="3dp"/>
            <gradient android:angle="270" android:startColor="#D7DFD9" android:endColor="#A6B8B8"/>
            <stroke android:width="1dp" android:color="#405B65"/>
        </shape>
    </item>
    <!-- Screen area -->
    <item android:left="11dp" android:top="14dp" android:right="11dp" android:bottom="13dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp"/>
            <solid android:color="#344F60"/>
        </shape>
    </item>
    <!-- Play triangle approximation using a small rounded rectangle lens mark -->
    <item android:left="17dp" android:top="17dp" android:right="17dp" android:bottom="16dp">
        <shape android:shape="oval">
            <solid android:color="#D4DCCB"/>
            <stroke android:width="1dp" android:color="#91A6A4"/>
        </shape>
    </item>
    <item android:left="19dp" android:top="19dp" android:right="18dp" android:bottom="18dp">
        <shape android:shape="oval"><solid android:color="#526F7A"/></shape>
    </item>
</layer-list>