<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#FF121C24"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:gravity="center_vertical"
        android:background="#FF1A2630"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFE7EDF2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ScreenVideo FREE"
            android:layout_weight="1.0" />

        <TextView
            android:id="@+id/version"
            android:textSize="12sp"
            android:textColor="#FF9EACB7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v0.1" />

    </LinearLayout>

    <TextView
        android:textStyle="bold"
        android:textColor="#FFB8D5E8"
        android:gravity="center"
        android:background="#FF1A2630"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:text="READY" />

    <TextView
        android:textSize="18sp"
        android:textColor="#FF7F909D"
        android:gravity="center"
        android:background="#FF1A2630"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:text="FRAMEBUFFER 480 × 800 RGBA"
        android:layout_weight="1.0" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/test"
            android:textColor="#FFEEF4F8"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="TEST"
            android:layout_weight="1.0" />

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/settings"
            android:textColor="#FFEEF4F8"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="SETTINGS"
            android:layout_weight="1.0" />

    </LinearLayout>

    <Button
        android:id="@+id/record"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="10dp"
        android:text="RECORD" />

    <TextView
        android:textSize="11sp"
        android:textColor="#FF81919D"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="5 FPS  •  32-bit RGBA  •  Shell Muxer" />

</LinearLayout>
