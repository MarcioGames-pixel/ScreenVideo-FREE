<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:background="@drawable/panel">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#e7edf2"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v0.1"
            android:textColor="#9eacb7"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/ready"
        android:textColor="#b8d5e8"
        android:textStyle="bold"
        android:background="@drawable/panel"/>

    <TextView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="FRAMEBUFFER
480 × 800
RGB565"
        android:textColor="#7f909d"
        android:textSize="18sp"
        android:background="@drawable/panel"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/test"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="TESTAR"
            android:textColor="#eef4f8"
            android:background="@drawable/button"/>

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp"/>

        <Button
            android:id="@+id/settings"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="CONFIG"
            android:textColor="#eef4f8"
            android:background="@drawable/button"/>
    </LinearLayout>

    <Button
        android:id="@+id/record"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="10dp"
        android:text="@string/record"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/button"/>

    <TextView
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="4 FPS  •  RGB565  •  /dev/graphics/fb0"
        android:textColor="#81919d"
        android:textSize="11sp"/>
</LinearLayout>
