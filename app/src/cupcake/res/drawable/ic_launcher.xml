<?xml version="1.0" encoding="utf-8"?>
<!-- Cupcake/Donut (Android 1.5–1.6): hand-built, simplified 3D fixed-perspective
     camcorder icon. Offset top/side planes and painted lens evoke 2009-era artwork. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ground shadow -->
    <item android:left="5dp" android:top="7dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp"/>
            <solid android:color="#55303B42"/>
        </shape>
    </item>
    <!-- Dark right and bottom side of the camera body -->
    <item android:left="7dp" android:top="7dp" android:right="3dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp"/>
            <gradient android:angle="0" android:startColor="#344954" android:endColor="#14242D"/>
            <stroke android:width="1dp" android:color="#14242D"/>
        </shape>
    </item>
    <!-- Raised upper face: offset to the upper left to create fixed perspective -->
    <item android:left="3dp" android:top="3dp" android:right="7dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp"/>
            <gradient android:angle="270" android:startColor="#C1D0D1" android:centerColor="#8199A0" android:endColor="#506873"/>
            <stroke android:width="1dp" android:color="#D7E0DE"/>
        </shape>
    </item>
    <!-- Main camera plate -->
    <item android:left="6dp" android:top="10dp" android:right="10dp" android:bottom="11dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp"/>
            <gradient android:angle="270" android:startColor="#607D89" android:centerColor="#405D6A" android:endColor="#2B424D"/>
            <stroke android:width="1dp" android:color="#293E48"/>
        </shape>
    </item>
    <!-- Lens rim -->
    <item android:left="10dp" android:top="13dp" android:right="14dp" android:bottom="14dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#E0E0CF" android:centerColor="#9DAEAA" android:endColor="#465E67"/>
            <stroke android:width="1dp" android:color="#E1E2D5"/>
        </shape>
    </item>
    <!-- Blue glass -->
    <item android:left="13dp" android:top="16dp" android:right="17dp" android:bottom="17dp">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#C2E2E1" android:centerColor="#4F9EAF" android:endColor="#173E55"/>
            <stroke android:width="1dp" android:color="#304D58"/>
        </shape>
    </item>
    <!-- Tiny red record lamp -->
    <item android:left="24dp" android:top="11dp" android:right="11dp" android:bottom="24dp">
        <shape android:shape="oval">
            <solid android:color="#C96B50"/>
            <stroke android:width="1dp" android:color="#E4A08A"/>
        </shape>
    </item>
</layer-list>
