<?xml version="1.0" encoding="utf-8"?>
<!-- Android 1.5/1.6 era: simplified 3D icon with fixed three-quarter perspective,
     rounded silhouette, transparent outside, and restrained accent colors. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cast shadow and dark side face -->
    <item android:left="5dp" android:top="7dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp"/>
            <gradient android:angle="0" android:startColor="#263B48" android:endColor="#111F29"/>
            <stroke android:width="1dp" android:color="#172731"/>
        </shape>
    </item>
    <!-- Raised top surface, offset to suggest the old fixed perspective -->
    <item android:left="3dp" android:top="3dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp"/>
            <gradient android:angle="270" android:startColor="#B5C8CF" android:centerColor="#718D9A" android:endColor="#435C69"/>
            <stroke android:width="1dp" android:color="#D3E0E4"/>
        </shape>
    </item>
    <!-- Camera body -->
    <item android:left="7dp" android:top="10dp" android:right="11dp" android:bottom="11dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp"/>
            <gradient android:angle="270" android:startColor="#4D6673" android:endColor="#253A46"/>
            <stroke android:width="1dp" android:color="#1B2B34"/>
        </shape>
    </item>
    <!-- Lens bezel -->
    <item android:left="12dp" android:top="14dp" android:right="16dp" android:bottom="15dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#D6D9C8" android:centerColor="#879CA0" android:endColor="#3A5665"/>
            <stroke android:width="1dp" android:color="#D9E0D7"/>
        </shape>
    </item>
    <!-- Lens glass -->
    <item android:left="15dp" android:top="17dp" android:right="19dp" android:bottom="18dp">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#9AD9E2" android:centerColor="#3B8FA8" android:endColor="#173C57"/>
            <stroke android:width="1dp" android:color="#263F4B"/>
        </shape>
    </item>
    <!-- Small record indicator -->
    <item android:left="23dp" android:top="11dp" android:right="12dp" android:bottom="24dp">
        <shape android:shape="oval"><solid android:color="#D77B55"/></shape>
    </item>
</layer-list>